.direnv/
result
result-*

# Claude Code agent worktrees — local scratch checkouts, never linted/committed
.claude/worktrees/

# Claude Code per-machine settings for this project. The flake sets the
# shared defaults in modules/dev/claude-code.nix. Local overrides stay local.
.claude/settings.local.json

# local-only planning notes — kept on disk, never committed
plans/

# local-only docs — kept on disk, never committed
/docs

# generated by home-manager (modules/desktop/eww.nix); imported by eww/eww.scss
/eww/_theme.scss

# generated by git-hooks.nix's dev-shell hook (flake.nix devShells): a symlink
# into the store that changes with every hook edit
.pre-commit-config.yaml
